# ============================================================
# VTB Bot — переменные окружения
# Это ШАБЛОН. Не коммить реальные секреты!
# Реальные значения — в панели Bothost → Переменные окружения
# ============================================================

# === MAX Bot ===
# Получить у @MasterBot в MAX или в личном кабинете botapi.max.ru
MAX_TOKEN=your_max_bot_token_here

# === Flask ===
SECRET_KEY=change_me_to_random_string

# === Google Apps Script (для дедупа) ===
SHEETS_URL=https://script.google.com/macros/s/ВАШ_ID/exec

# === Пути (обычно не меняются) ===
DATA_DIR=/app/data
OUTPUT_DIR=/app/VTB_Объявления
DB_PATH=/app/data/vtb_parser.db
LOG_DIR=/app/logs

# === Порт (Bothost подставит автоматически) ===
PORT=3000

# === Расписание публикаций (МСК) ===
SCHEDULE_START=06:00
SCHEDULE_END=20:00
DAILY_LIMIT=150
